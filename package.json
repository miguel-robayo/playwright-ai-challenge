{
  "name": "playwright-ai-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Reto técnico de QA Automation con Playwright, TypeScript y playwright-bdd sobre Automation Exercise",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:functional": "playwright test --project=functional",
    "test:ai": "playwright test --project=ai",
    "test:ai-unit": "playwright test --project=ai-unit",
    "test:headed": "playwright test --project=functional --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=functional --debug",
    "test:list": "playwright test --list",
    "bddgen": "bddgen",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --output allure-report --clean",
    "report:allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:list"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
