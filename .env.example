# Copia este archivo como .env y ajusta los valores. .env no se versiona.
# Las variables definidas en el entorno del proceso tienen prioridad sobre este archivo.

# Perfil de ejecución: local | ci.
# Si se omite, se usa "ci" cuando existe la variable CI y "local" en otro caso.
TEST_ENV=local

# Identificador de la ejecución; forma parte de la semilla de los datos sintéticos.
# Si se omite, se genera uno nuevo en cada ejecución. Fijarlo reproduce los mismos datos
# (salvo las contraseñas, que siempre son aleatorias).
TEST_RUN_ID=

# URL de la aplicación bajo prueba.
BASE_URL=https://automationexercise.com

# Proveedor de IA. Solo se admite "anthropic". Lo usa únicamente el proyecto "ai".
AI_PROVIDER=anthropic

# Clave de API de Anthropic. Déjala vacía para ejecutar solo la suite funcional:
# los escenarios @ai se omiten con el motivo "ANTHROPIC_API_KEY no configurada".
ANTHROPIC_API_KEY=
# Alias aceptado (nombre que usa el enunciado del reto). ANTHROPIC_API_KEY tiene prioridad.
AI_API_KEY=

# Modelo de Claude para los escenarios de IA. Si se omite: claude-opus-5-5.
AI_MODEL=
