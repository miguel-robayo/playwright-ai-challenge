# Copia este archivo como .env y ajusta los valores. .env no se versiona.
# Las variables definidas en el entorno del proceso tienen prioridad sobre este archivo.

# Perfil de ejecución: local | ci.
# Si se omite, se usa "ci" cuando existe la variable CI y "local" en otro caso.
TEST_ENV=local

# URL de la aplicación bajo prueba.
BASE_URL=https://automationexercise.com

# Proveedor de IA. Solo se admite "anthropic". Lo usa únicamente el proyecto "ai".
AI_PROVIDER=anthropic

# Clave de API de Anthropic. Déjala vacía para ejecutar solo la suite funcional:
# los escenarios @ai se omiten con el motivo "AI_API_KEY no configurada".
AI_API_KEY=

# Modelo de Claude para los escenarios de IA. Se definirá en la fase de IA.
AI_MODEL=
